{
  "name": "jylos-markdown-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Offline CodeMirror 6 bundle embedded in the Jylos JavaFX editor.",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --target=safari15 --outfile=../src/main/resources/com/example/jylos/ui/editor/editor.bundle.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.7",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.11.3",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2"
  },
  "devDependencies": {
    "esbuild": "0.25.8",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
