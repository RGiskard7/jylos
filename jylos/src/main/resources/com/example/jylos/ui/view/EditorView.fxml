<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.example.jylos.ui.web.JavaFxHtmlView?>
<?import com.example.jylos.ui.components.MarkdownEditorView?>
<?import com.example.jylos.ui.components.EmptyStateTiles?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="editorContainer" styleClass="editor-container" HBox.hgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.jylos.ui.controller.EditorController">

    <!-- ── Open-note tabs (one per open note; hidden when none; scrolls horizontally) ── -->
    <ScrollPane fx:id="editorTabScroll" styleClass="editor-tab-scroll"
                hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true"
                visible="false" managed="false">
        <HBox fx:id="editorTabBar" styleClass="editor-tab-bar"/>
    </ScrollPane>

    <!-- ── Editor Header ─────────────────────────────────────────────────── -->
    <HBox fx:id="editorHeaderBar" alignment="CENTER_LEFT" spacing="6" styleClass="editor-header">
        <!-- Same vertical padding as the side panel's header (.sidebar-nav-bar) and the notes
             list's (.notes-header), so all are equally tall and their bottom lines meet. Little
             margin above and below the buttons, as Obsidian's headers. -->
        <padding>
            <Insets top="4" right="16" bottom="4" left="16"/>
        </padding>

        <!-- Navigation arrows (back / forward) — same corner as Obsidian -->
        <Button fx:id="navBackBtn" onAction="#handleNavigateBack" styleClass="nav-btn" disable="true">
            <tooltip><Tooltip text="%tooltip.navigate_back"/></tooltip>
            <graphic><FontIcon iconLiteral="fth-chevron-left" styleClass="feather-icon"/></graphic>
        </Button>
        <Button fx:id="navForwardBtn" onAction="#handleNavigateForward" styleClass="nav-btn" disable="true">
            <tooltip><Tooltip text="%tooltip.navigate_forward"/></tooltip>
            <graphic><FontIcon iconLiteral="fth-chevron-right" styleClass="feather-icon"/></graphic>
        </Button>

        <!-- What belongs to the open note; a new, empty tab keeps only back and forward. -->
        <HBox fx:id="noteHeaderControls" alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
            <Separator orientation="VERTICAL" styleClass="header-separator"/>

            <!-- Inline save indicator: amber dot = unsaved, green = saved. -->
            <!-- Folders of the open note (folder / sub /); the title follows. Clicking reveals
                 the note in the Explorer tree. Replaces the separate path row. The save state is
                 shown in the status bar and on the tab, so there is no dot here. -->
            <Label fx:id="notePathLabel" styleClass="note-path" minWidth="0" visible="false" managed="false"/>

            <!-- Private note indicator: closed lock = locked, open lock = unlocked this session. -->
            <Label fx:id="privateIndicator" styleClass="editor-private-indicator"
                   visible="false" managed="false">
                <graphic><FontIcon fx:id="privateIndicatorIcon" iconLiteral="fth-lock" styleClass="feather-icon"/></graphic>
                <tooltip><Tooltip fx:id="privateIndicatorTip" text="%tooltip.note_private_locked"/></tooltip>
            </Label>

            <TextField fx:id="noteTitleField" promptText="%panel.editor.title_placeholder"
                       HBox.hgrow="ALWAYS" styleClass="title-field"/>
            <!-- Read (preview-only) view: title shown as a plain heading, not an input. -->
            <Label fx:id="noteTitleLabel" styleClass="title-heading" HBox.hgrow="ALWAYS"
                   maxWidth="Infinity" visible="false" managed="false"/>
            <HBox fx:id="noteOnlyControls" alignment="CENTER_LEFT" spacing="6">
                <Separator orientation="VERTICAL" styleClass="header-separator"/>

                <!-- Obsidian-style view switch: book opens reading view, pencil returns to editing. -->
                <Button fx:id="readingModeButton" onAction="#handleToggleReadingMode" styleClass="modern-toggle-btn">
                    <tooltip><Tooltip fx:id="readingModeTooltip" text="%tooltip.switch_to_reading"/></tooltip>
                    <graphic><FontIcon fx:id="readingModeIcon" iconLiteral="fth-book-open" styleClass="feather-icon"/></graphic>
                </Button>

                <Button fx:id="editorSaveBtn" onAction="#handleSave" styleClass="modern-toggle-btn">
                    <tooltip><Tooltip text="%action.save"/></tooltip>
                    <graphic><FontIcon iconLiteral="fth-save" styleClass="feather-icon"/></graphic>
                </Button>

                <!-- Properties and tags: each opens and closes its bar under the title. -->
                <ToggleButton fx:id="togglePropertiesBtn" onAction="#handleToggleProperties" styleClass="modern-toggle-btn, icon-only-btn"
                              contentDisplay="GRAPHIC_ONLY" selected="false">
                    <tooltip><Tooltip text="%tooltip.toggle_properties"/></tooltip>
                    <graphic>
                        <StackPane>
                            <FontIcon iconLiteral="fth-sliders" styleClass="feather-icon"/>
                            <!-- Marks a note that has properties while the panel is closed. -->
                            <Region fx:id="propertiesDot" styleClass="toggle-dot" StackPane.alignment="TOP_RIGHT"
                                    visible="false" mouseTransparent="true"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="toggleTagsBtn" onAction="#handleToggleTags" styleClass="modern-toggle-btn" selected="false">
                    <tooltip><Tooltip text="%tooltip.toggle_tags"/></tooltip>
                    <graphic><FontIcon iconLiteral="fth-hash" styleClass="feather-icon"/></graphic>
                </ToggleButton>
            </HBox>

            <!-- Only for a board note: view it as Markdown, and back as its board. -->
            <Button fx:id="boardViewBtn" onAction="#handleBoardView" styleClass="modern-toggle-btn"
                    visible="false" managed="false">
                <tooltip><Tooltip fx:id="boardViewTooltip" text="%kanban.view_markdown"/></tooltip>
                <graphic><FontIcon fx:id="boardViewIcon" iconLiteral="fth-file-text" styleClass="feather-icon"/></graphic>
            </Button>
            <ToggleButton fx:id="pinButton" onAction="#handleTogglePin" styleClass="modern-toggle-btn">
                <tooltip><Tooltip text="%tooltip.pin_note"/></tooltip>
                <graphic><FontIcon iconLiteral="bi-pin-angle" styleClass="feather-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="favoriteButton" onAction="#handleToggleFavorite" styleClass="modern-toggle-btn">
                <tooltip><Tooltip text="%tooltip.add_favorite"/></tooltip>
                <graphic><FontIcon iconLiteral="fth-star" styleClass="feather-icon"/></graphic>
            </ToggleButton>
        </HBox>
    </HBox>

    <!-- ── Tags Bar (collapsible) ─────────────────────────────────────────── -->
    <VBox fx:id="tagsContainer" visible="false" managed="false">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="tags-bar">
            <padding>
                <Insets top="6" right="16" bottom="6" left="16"/>
            </padding>
            <FlowPane fx:id="tagsFlowPane" hgap="6" vgap="6" styleClass="tags-flow" HBox.hgrow="ALWAYS"/>
            <Label fx:id="modifiedDateLabel" text="" styleClass="meta-label"/>
        </HBox>
    </VBox>

    <!-- ── Properties panel (opened from its button in the title row) ────── -->
    <!--  Editable rows and "+ Add property" while editing; read-only rows,     -->
    <!--  or "No properties", in the reading view. No scroll: fits its rows.    -->
    <VBox fx:id="propertiesSection" visible="false" managed="false" styleClass="properties-panel">
        <VBox fx:id="propertiesContent" styleClass="properties-content" spacing="1">
            <padding><Insets top="6" right="12" bottom="2" left="16"/></padding>
        </VBox>
        <Label fx:id="propertiesEmptyLabel" text="%panel.properties.empty" styleClass="properties-empty"
               visible="false" managed="false">
            <padding><Insets top="0" right="12" bottom="8" left="16"/></padding>
        </Label>
        <HBox fx:id="addPropertyRow" alignment="CENTER_LEFT">
            <padding><Insets top="0" right="12" bottom="8" left="16"/></padding>
            <Button fx:id="addPropertyBtn" text="%action.add_property_line"
                    onAction="#handleAddProperty" styleClass="add-property-btn">
                <tooltip><Tooltip text="%tooltip.add_property"/></tooltip>
            </Button>
        </HBox>
    </VBox>

    <!-- ── Content: editor/preview split with an empty-state overlay ───────── -->
    <StackPane fx:id="editorContentStack" VBox.vgrow="ALWAYS">
    <SplitPane fx:id="editorPreviewSplitPane" orientation="HORIZONTAL" dividerPositions="0.5"
               styleClass="editor-split">

        <!-- Editor Pane -->
        <VBox fx:id="editorPane" VBox.vgrow="ALWAYS" styleClass="editor-pane">
            <!-- The notch over the editor's bottom edge brings back a folded format bar. -->
            <StackPane VBox.vgrow="ALWAYS">
                <MarkdownEditorView fx:id="noteContentArea" styleClass="editor-area"/>
                <Button fx:id="formatToolbarNotch" styleClass="format-toolbar-notch" StackPane.alignment="BOTTOM_CENTER"
                        visible="false">
                    <graphic><FontIcon iconLiteral="fth-chevron-up" styleClass="feather-icon"/></graphic>
                    <tooltip><Tooltip text="%tooltip.show_format_toolbar"/></tooltip>
                </Button>
            </StackPane>

            <!-- Format Toolbar -->
            <HBox fx:id="formatToolbarContainer" styleClass="format-toolbar-container">
                <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true"
                            styleClass="format-toolbar-scroll" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="2" styleClass="format-toolbar">
                        <padding>
                            <Insets top="0" right="8" bottom="0" left="8"/>
                        </padding>
                        <Button fx:id="undoBtn" onAction="#handleFormatToolbarUndo" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-rotate-ccw" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%action.undo"/></tooltip>
                        </Button>
                        <Button fx:id="redoBtn" onAction="#handleFormatToolbarRedo" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-rotate-cw" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%action.redo"/></tooltip>
                        </Button>
                        <Separator orientation="VERTICAL" styleClass="format-separator"/>
                        <!-- Headings (Feather has no heading glyph → clean typographic labels) -->
                        <Button fx:id="heading1Btn" text="H1" onAction="#handleHeading1" styleClass="format-btn,format-btn-text">
                            <tooltip><Tooltip text="%tooltip.format.heading1"/></tooltip>
                        </Button>
                        <Button fx:id="heading2Btn" text="H2" onAction="#handleHeading2" styleClass="format-btn,format-btn-text">
                            <tooltip><Tooltip text="%tooltip.format.heading2"/></tooltip>
                        </Button>
                        <Button fx:id="heading3Btn" text="H3" onAction="#handleHeading3" styleClass="format-btn,format-btn-text">
                            <tooltip><Tooltip text="%tooltip.format.heading3"/></tooltip>
                        </Button>
                        <Separator orientation="VERTICAL" styleClass="format-separator"/>
                        <!-- Inline emphasis -->
                        <Button fx:id="boldBtn" onAction="#handleBold" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-bold" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.bold"/></tooltip>
                        </Button>
                        <Button fx:id="italicBtn" onAction="#handleItalic" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-italic" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.italic"/></tooltip>
                        </Button>
                        <Button fx:id="strikeBtn" text="S" onAction="#handleStrike" styleClass="format-btn,format-btn-text,format-strike">
                            <tooltip><Tooltip text="%tooltip.format.strike"/></tooltip>
                        </Button>
                        <Button fx:id="underlineBtn" onAction="#handleUnderline" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-underline" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.underline"/></tooltip>
                        </Button>
                        <Button fx:id="highlightBtn" text="H" onAction="#handleHighlight" styleClass="format-btn,format-btn-text,format-highlight">
                            <tooltip><Tooltip text="%tooltip.format.highlight"/></tooltip>
                        </Button>
                        <Separator orientation="VERTICAL" styleClass="format-separator"/>
                        <!-- Insert -->
                        <Button fx:id="linkBtn" onAction="#handleLink" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-link" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.link"/></tooltip>
                        </Button>
                        <Button fx:id="richLinkBtn" onAction="#handleRichLink" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-bookmark" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.rich_link"/></tooltip>
                        </Button>
                        <Button fx:id="imageBtn" onAction="#handleImage" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-image" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.image"/></tooltip>
                        </Button>
                        <Separator orientation="VERTICAL" styleClass="format-separator"/>
                        <!-- Lists -->
                        <Button fx:id="todoBtn" onAction="#handleTodoList" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-check-square" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.checkbox"/></tooltip>
                        </Button>
                        <Button fx:id="bulletBtn" onAction="#handleBulletList" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-list" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.bullet"/></tooltip>
                        </Button>
                        <Button fx:id="numberBtn" text="1." onAction="#handleNumberedList" styleClass="format-btn,format-btn-text">
                            <tooltip><Tooltip text="%tooltip.format.numbered"/></tooltip>
                        </Button>
                        <Separator orientation="VERTICAL" styleClass="format-separator"/>
                        <!-- Blocks -->
                        <Button fx:id="quoteBtn" text="&#10077;" onAction="#handleQuote" styleClass="format-btn,format-btn-text,format-quote">
                            <tooltip><Tooltip text="%tooltip.format.quote"/></tooltip>
                        </Button>
                        <Button fx:id="codeBtn" onAction="#handleCode" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-code" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.format.code"/></tooltip>
                        </Button>
                    </HBox>
                </ScrollPane>
                <!-- Pinned outside the scrollable area (unlike the format buttons above,
                     which scroll off on a narrow window) so delete stays reachable. -->
                <HBox alignment="CENTER_LEFT" spacing="6" styleClass="format-toolbar">
                        <Button fx:id="editorDeleteBtn" onAction="#handleDelete" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-trash-2" styleClass="feather-icon-danger"/></graphic>
                            <tooltip><Tooltip text="%action.delete"/></tooltip>
                        </Button>
                        <!-- Folds the bar away; the notch it leaves brings it back. -->
                        <Button fx:id="collapseFormatToolbarBtn" styleClass="format-btn">
                            <graphic><FontIcon iconLiteral="fth-chevron-down" styleClass="feather-icon"/></graphic>
                            <tooltip><Tooltip text="%tooltip.hide_format_toolbar"/></tooltip>
                        </Button>
                </HBox>
            </HBox>
        </VBox>

        <!-- Preview Pane -->
        <VBox fx:id="previewPane" styleClass="preview-pane">
            <JavaFxHtmlView fx:id="previewWebView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>

        <!-- Empty state: shown when no note is open, at startup and in a new tab. "New note"
             on its own; the rest as tiles, 4, 2 or 1 across depending on the width. -->
        <!-- Scrolls when it does not fit: a short window or a large interface font. -->
        <ScrollPane fx:id="emptyState" styleClass="editor-empty-state-scroll" fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" pickOnBounds="true" managed="true" visible="true">
        <VBox alignment="CENTER" spacing="16" styleClass="editor-empty-state" pickOnBounds="true">
            <FontIcon iconLiteral="fth-file-text" styleClass="empty-state-icon"/>
            <Label text="%empty.no_note" styleClass="empty-state-title"/>
            <Button text="%empty.create_note" onAction="#handleEmptyCreate" styleClass="empty-state-btn">
                <graphic><FontIcon iconLiteral="fth-file-plus" styleClass="feather-icon"/></graphic>
            </Button>
            <EmptyStateTiles fx:id="emptyStateTiles" alignment="CENTER" hgap="12" vgap="12" prefColumns="4"
                      prefTileWidth="150" prefTileHeight="96" maxWidth="-Infinity" styleClass="empty-state-tiles">
                <Button text="%empty.create_canvas" onAction="#handleEmptyCreateCanvas" styleClass="empty-state-btn-secondary, empty-state-tile"
                        contentDisplay="GRAPHIC_ONLY" alignment="TOP_CENTER" maxWidth="Infinity" maxHeight="Infinity">
                    <graphic><VBox alignment="TOP_CENTER" spacing="6">
                        <FontIcon iconLiteral="fth-layout" styleClass="feather-icon"/>
                        <Label text="%empty.create_canvas" styleClass="empty-state-tile-label"/>
                    </VBox></graphic>
                </Button>
                <Button text="%empty.go_to_file" onAction="#handleEmptyGoToFile" styleClass="empty-state-btn-secondary, empty-state-tile"
                        contentDisplay="GRAPHIC_ONLY" alignment="TOP_CENTER" maxWidth="Infinity" maxHeight="Infinity">
                    <graphic><VBox alignment="TOP_CENTER" spacing="6">
                        <FontIcon iconLiteral="fth-search" styleClass="feather-icon"/>
                        <Label text="%empty.go_to_file" styleClass="empty-state-tile-label"/>
                        <Label styleClass="empty-state-shortcut" userData="Shortcut+O"/>
                    </VBox></graphic>
                </Button>
                <Button text="%empty.open_graph" onAction="#handleEmptyOpenGraph" styleClass="empty-state-btn-secondary, empty-state-tile"
                        contentDisplay="GRAPHIC_ONLY" alignment="TOP_CENTER" maxWidth="Infinity" maxHeight="Infinity">
                    <graphic><VBox alignment="TOP_CENTER" spacing="6">
                        <FontIcon iconLiteral="fth-share-2" styleClass="feather-icon"/>
                        <Label text="%empty.open_graph" styleClass="empty-state-tile-label"/>
                        <Label styleClass="empty-state-shortcut" userData="Shortcut+G"/>
                    </VBox></graphic>
                </Button>
                <Button text="%empty.open_kanban" onAction="#handleEmptyOpenKanban" styleClass="empty-state-btn-secondary, empty-state-tile"
                        contentDisplay="GRAPHIC_ONLY" alignment="TOP_CENTER" maxWidth="Infinity" maxHeight="Infinity">
                    <graphic><VBox alignment="TOP_CENTER" spacing="6">
                        <FontIcon iconLiteral="fth-columns" styleClass="feather-icon"/>
                        <Label text="%empty.open_kanban" styleClass="empty-state-tile-label"/>
                        <Label styleClass="empty-state-shortcut" userData="Shortcut+K"/>
                    </VBox></graphic>
                </Button>
            </EmptyStateTiles>
        </VBox>
        </ScrollPane>
    </StackPane>
</VBox>
