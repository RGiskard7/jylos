<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="graphRoot" styleClass="graph-view" maxWidth="Infinity" maxHeight="Infinity"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.jylos.ui.controller.GraphController">

    <HBox alignment="CENTER_LEFT" spacing="6" styleClass="graph-toolbar">
        <padding>
            <Insets top="8" right="16" bottom="8" left="16"/>
        </padding>

        <!-- Back and forward in the graph's tab, as in a note's header. -->
        <Button fx:id="graphBackBtn" onAction="#handleNavigateBack" styleClass="nav-btn" disable="true">
            <tooltip><Tooltip text="%tooltip.navigate_back"/></tooltip>
            <graphic><FontIcon iconLiteral="fth-chevron-left" styleClass="feather-icon"/></graphic>
        </Button>
        <Button fx:id="graphForwardBtn" onAction="#handleNavigateForward" styleClass="nav-btn" disable="true">
            <tooltip><Tooltip text="%tooltip.navigate_forward"/></tooltip>
            <graphic><FontIcon iconLiteral="fth-chevron-right" styleClass="feather-icon"/></graphic>
        </Button>
        <Separator orientation="VERTICAL" styleClass="header-separator"/>

        <FontIcon iconLiteral="fth-share-2" styleClass="feather-icon">
            <HBox.margin><Insets left="6"/></HBox.margin>
        </FontIcon>
        <Label fx:id="graphTitleLabel" text="%graph.title" styleClass="graph-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <ToggleButton fx:id="localGraphBtn" onAction="#handleToggleScope" styleClass="modern-toggle-btn">
            <tooltip><Tooltip text="%graph.local"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-target" styleClass="feather-icon"/>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="showTagsBtn" onAction="#handleToggleTags" selected="false" styleClass="modern-toggle-btn">
            <tooltip><Tooltip text="%graph.show_tags"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-hash" styleClass="feather-icon"/>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="settingsBtn" onAction="#handleToggleSettings" styleClass="modern-toggle-btn">
            <tooltip><Tooltip text="%graph.settings"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-settings" styleClass="feather-icon"/>
            </graphic>
        </ToggleButton>
        <Button fx:id="zoomOutBtn" onAction="#handleZoomOut" styleClass="toolbar-btn">
            <tooltip><Tooltip text="%graph.zoom_out"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-zoom-out" styleClass="feather-icon"/>
            </graphic>
        </Button>
        <Button fx:id="zoomInBtn" onAction="#handleZoomIn" styleClass="toolbar-btn">
            <tooltip><Tooltip text="%graph.zoom_in"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-zoom-in" styleClass="feather-icon"/>
            </graphic>
        </Button>
        <Button fx:id="resetViewBtn" onAction="#handleResetView" styleClass="toolbar-btn">
            <tooltip><Tooltip text="%graph.reset_view"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-maximize-2" styleClass="feather-icon"/>
            </graphic>
        </Button>
        <Button fx:id="refreshGraphBtn" onAction="#handleRefresh" styleClass="toolbar-btn">
            <tooltip><Tooltip text="%graph.refresh"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-refresh-cw" styleClass="feather-icon"/>
            </graphic>
        </Button>
        <Button fx:id="closeGraphBtn" onAction="#handleClose" styleClass="toolbar-btn">
            <tooltip><Tooltip text="%graph.close"/></tooltip>
            <graphic>
                <FontIcon iconLiteral="fth-x" styleClass="feather-icon"/>
            </graphic>
        </Button>
    </HBox>

    <StackPane fx:id="graphCanvasHolder" VBox.vgrow="ALWAYS" styleClass="graph-canvas-holder">
        <!-- Settings panel overlay (canvas is added behind it by the controller). -->
        <ScrollPane fx:id="settingsScrollPane" visible="false" managed="false"
                    fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    maxWidth="250" maxHeight="Infinity"
                    styleClass="panel-scroll,graph-settings-scroll"
                    StackPane.alignment="TOP_RIGHT">
            <StackPane.margin><Insets top="14" right="14" bottom="14" left="0"/></StackPane.margin>
            <content>
                <VBox fx:id="settingsPanel" spacing="6"
                      styleClass="graph-settings">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                    <!-- How many notes and links the graph shown has. -->
                    <Label fx:id="graphStatsLabel" styleClass="graph-settings-stats"/>

                    <Label text="%graph.filters" styleClass="graph-settings-header"/>
                    <TextField fx:id="graphFilterField" promptText="%graph.filter_text"/>
                    <Label text="%graph.filter_tag" styleClass="graph-settings-label"/>
                    <ComboBox fx:id="tagFilterCombo" maxWidth="Infinity"/>
                    <Label text="%graph.filter_folder" styleClass="graph-settings-label"/>
                    <ComboBox fx:id="folderFilterCombo" maxWidth="Infinity"/>
                    <CheckBox fx:id="orphansCheck" text="%graph.show_orphans" selected="true" onAction="#handleFilters"/>
                    <CheckBox fx:id="ghostsCheck" text="%graph.show_unresolved" selected="true" onAction="#handleFilters"/>
                    <CheckBox fx:id="attachmentsCheck" text="%graph.show_attachments" onAction="#handleFilters"/>

                    <!-- Local graph (applies when the graph shows the open note) -->
                    <Separator/>
                    <Label text="%graph.local_section" styleClass="graph-settings-header"/>
                    <Label text="%graph.local_depth" styleClass="graph-settings-label"/>
                    <Slider fx:id="localDepthSlider" min="1" max="5" value="1" majorTickUnit="1" minorTickCount="0"
                            snapToTicks="true" showTickLabels="true" showTickMarks="true"/>
                    <CheckBox fx:id="localIncomingCheck" text="%graph.local_incoming" selected="true" onAction="#handleFilters"/>
                    <CheckBox fx:id="localOutgoingCheck" text="%graph.local_outgoing" selected="true" onAction="#handleFilters"/>
                    <CheckBox fx:id="localNeighborCheck" text="%graph.local_neighbors" onAction="#handleFilters"/>

                    <!-- Colour groups: the first one a note matches gives its colour -->
                    <Separator/>
                    <Label text="%graph.groups" styleClass="graph-settings-header"/>
                    <VBox fx:id="colorGroupsBox" spacing="4"/>
                    <Button fx:id="addColorGroupBtn" text="%graph.new_group" onAction="#handleAddColorGroup"
                            styleClass="graph-new-group"/>

                    <Separator/>
                    <Label text="%graph.display" styleClass="graph-settings-header"/>
                    <CheckBox fx:id="arrowsCheck" text="%graph.arrows" onAction="#handleArrows"/>
                    <CheckBox fx:id="colorFolderCheck" text="%graph.color_by_folder" onAction="#handleColorMode"/>
                    <Label text="%graph.label_threshold" styleClass="graph-settings-label"/>
                    <Slider fx:id="labelThresholdSlider" min="0" max="200"/>
                    <Label text="%graph.node_size" styleClass="graph-settings-label"/>
                    <Slider fx:id="nodeScaleSlider" min="30" max="300"/>
                    <Label text="%graph.line_thickness" styleClass="graph-settings-label"/>
                    <Slider fx:id="lineThicknessSlider" min="30" max="400"/>

                    <Separator/>
                    <Label text="%graph.forces" styleClass="graph-settings-header"/>
                    <Label text="%graph.center_force" styleClass="graph-settings-label"/>
                    <Slider fx:id="centerSlider" min="0" max="300"/>
                    <Label text="%graph.repulsion" styleClass="graph-settings-label"/>
                    <Slider fx:id="repulsionSlider" min="0" max="2000"/>
                    <Label text="%graph.link_force" styleClass="graph-settings-label"/>
                    <Slider fx:id="linkForceSlider" min="0" max="200"/>
                    <Label text="%graph.link_distance" styleClass="graph-settings-label"/>
                    <Slider fx:id="linkDistanceSlider" min="30" max="500"/>
                </VBox>
            </content>
        </ScrollPane>
    </StackPane>
</VBox>
